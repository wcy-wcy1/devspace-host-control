FROM node:22-bookworm-slim

# The host also pins the final image by digest. Update this version deliberately.
ARG CODEX_VERSION=0.169.0
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && mkdir -p /etc/ssl/certs \
    && node -e "require('fs').writeFileSync('/etc/ssl/certs/node-roots.pem',require('tls').rootCertificates.join('\n'))" \
    && sed -i 's|http://|https://|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=3 -o Acquire::https::CaInfo=/etc/ssl/certs/node-roots.pem update \
    && (apt-get -o Acquire::Retries=3 -o Acquire::https::CaInfo=/etc/ssl/certs/node-roots.pem install -y --no-install-recommends git ca-certificates chromium \
      || apt-get -o Acquire::Retries=3 -o Acquire::https::CaInfo=/etc/ssl/certs/node-roots.pem install -y --no-install-recommends git ca-certificates chromium \
      || apt-get -o Acquire::Retries=3 -o Acquire::https::CaInfo=/etc/ssl/certs/node-roots.pem install -y --no-install-recommends git ca-certificates chromium)
RUN npm install --global "@openai/codex@${CODEX_VERSION}" --no-audit --no-fund && npm cache clean --force
COPY runner.mjs /opt/hostcontrol/runner.mjs
WORKDIR /workspace
ENTRYPOINT ["node", "/opt/hostcontrol/runner.mjs"]
